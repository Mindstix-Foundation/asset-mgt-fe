                >
                  <i class="fas fa-filter me-1"></i>Filters
                </button>
              </div>
            </div>
          </div>
        </div>
          
        <!-- Filter Dropdown -->
        <div v-if="showFilterDropdown" class="filter-dropdown mt-3 p-3 bg-light rounded">
          <div class="row">
            <div class="col-12">
              <!-- Bootstrap Flexbox for equal width filters -->
              <div class="d-flex flex-column flex-md-row gap-2">
                <!-- Asset Count Filter -->
                <div class="flex-fill">
                  <label class="form-label">Asset Count</label>
                  <select class="form-select" v-model="assetCountFilter" @change="filterEmployees">
                    <option value="">All</option>
                    <option value="0">No Assets</option>
                    <option value="1-2">1-2 Assets</option>
                    <option value="3+">3+ Assets</option>
                  </select>
                </div>
                
                <!-- Status Filter -->
                <div class="flex-fill">
