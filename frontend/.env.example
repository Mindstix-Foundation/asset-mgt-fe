# ==============================================================================
# Asset Management Frontend - Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` for local development, or to `.env.production` on
# the build server before running `npm run build`. NEVER commit `.env` to git.
# ==============================================================================

# Base URL for the backend API.
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:3000/api
#
# Production (when frontend & backend are served from the same domain via
# Nginx reverse-proxy — recommended setup):
#   VITE_API_BASE_URL=https://assets.yourcompany.com/api
#
# Production (when frontend & backend are on different subdomains):
#   VITE_API_BASE_URL=https://api.yourcompany.com/api
#
VITE_API_BASE_URL=http://localhost:3000/api

# Google OAuth client ID/secret live on the backend only
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET). Frontend only needs VITE_API_BASE_URL.
